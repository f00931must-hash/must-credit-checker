rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email; }
    function isAuthorized() { return signedIn() && exists(/databases/$(database)/documents/authorizedUsers/$(email())); }
    function isAdmin() { return isAuthorized() && get(/databases/$(database)/documents/authorizedUsers/$(email())).data.role == 'admin'; }
    function owns(data) { return isAdmin() || (isAuthorized() && data.ownerEmail == email()); }

    match /authorizedUsers/{userEmail} {
      allow read: if isAdmin() || (signedIn() && userEmail == email());
      allow write: if isAdmin();
    }
    match /students/{studentId} {
      allow create: if isAuthorized() && request.resource.data.ownerEmail == email();
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && request.resource.data.ownerEmail == resource.data.ownerEmail;
    }
    match /curricula/{curriculumId} {
      allow read: if isAuthorized();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
